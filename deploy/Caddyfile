# ═══════════════════════════════════════════════════════════════
# Irazu — Caddy configuration (production reference)
# Target: Oracle Cloud (OCI) VM, EU region. Caddy obtains and renews
# TLS certificates automatically (Let's Encrypt / ZeroSSL).
# Aligned with OWASP Secure Headers and NIS2 "security by design".
# ═══════════════════════════════════════════════════════════════
{
	# Global options
	email ops@irazu.fi
	servers {
		protocols h1 h2 h3
	}
}

www.irazu.fi {
	redir https://irazu.fi{uri} permanent
}

irazu.fi {
	root * /srv/site/dist
	encode zstd gzip

	header {
		# ── Content-Security-Policy ───────────────────────────────
		# Only our own origin. No inline scripts/styles, no third parties.
		# frame-ancestors 'none' replaces X-Frame-Options in modern browsers.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

		# ── HSTS: force HTTPS for 2 years, incl. subdomains ──────
		# "preload" deliberately absent: with it in the header anyone can submit
		# irazu.fi to the browsers' preload list, which takes months to undo.
		# Add it (and submit at hstspreload.org) only once every subdomain is
		# confirmed to serve HTTPS for good.
		Strict-Transport-Security "max-age=63072000; includeSubDomains"

		# ── Clickjacking (legacy browsers) ───────────────────────
		X-Frame-Options "DENY"

		# ── MIME sniffing ────────────────────────────────────────
		X-Content-Type-Options "nosniff"

		# ── Referrer & powerful features ─────────────────────────
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

		# ── Cross-origin isolation ───────────────────────────────
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"

		# Hide server banner
		-Server
	}

	# Caching. Asset names are NOT fingerprinted (styles.css, main.js…), so CSS, JS
	# and HTML are revalidated on every visit (cheap 304 via ETag): a new release
	# shows up at once. Fonts never change under the same name; images rarely do.
	@fonts path /assets/fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
	@images path /assets/img/* /assets/brand/* /assets/og/* /assets/*.svg /assets/*.png
	header @images Cache-Control "public, max-age=604800"
	@revalidate path *.html / */ /assets/css/* /assets/js/* /robots.txt /sitemap.xml
	header @revalidate Cache-Control "no-cache"

	# ── Contact form API → small Node (Hono) service on localhost ─
	# services/contact (see deploy/CONTACT.md): same-origin + JSON only, strict
	# Zod schema with length limits, honeypot + time trap, rate limits, then one
	# plain-text email via Brevo SMTP (TLS). Nothing is stored (data minimisation).
	handle /api/contact {
		# Basic body-size guard (briefing max 4000 chars)
		request_body {
			max_size 16KiB
		}
		reverse_proxy 127.0.0.1:8787
	}
	# Rate limiting is enforced inside the service (5 per IP / 10 min, 40 per hour
	# in total). Caddy passes the client IP in X-Forwarded-For (default behaviour).

	file_server

	# ── Logs: GDPR — truncate IPs, short retention ───────────────
	# Also the only source of visit statistics (no analytics script):
	# see deploy/STATS.md.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 336h # 14 days
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>client_ip ip_mask {
					ipv4 24
					ipv6 48
				}
				request>headers>Cookie delete
				request>headers>User-Agent delete
			}
		}
	}
}
