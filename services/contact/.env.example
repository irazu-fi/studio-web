# Template for /etc/irazu/contact.env (production) — copy, fill in, chmod 600.
# Never commit the real file (.env* is git-ignored; only this example is tracked).

HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=https://irazu.fi

# Brevo SMTP relay (Settings → SMTP & API). The key is generated on deploy day
# and exists only in the server's env file.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=<brevo SMTP login>
SMTP_PASS=<brevo SMTP key>

MAIL_FROM=Irazu <hello@irazu.fi>
MAIL_TO=hello@irazu.fi

# Local development only: validate everything but send nothing.
DRY_RUN=false

# Abuse limits (per client IP / global per hour, protects the Brevo 300/day quota).
RATE_PER_IP=5
RATE_WINDOW_MIN=10
RATE_GLOBAL_PER_HOUR=40
