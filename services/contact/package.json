{
  "name": "irazu-contact",
  "version": "1.0.0",
  "private": true,
  "description": "Contact form endpoint for irazu.fi — validates, filters bots and forwards one plain-text email via SMTP (Brevo). Stores nothing.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "nodemailer": "10.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "smtp-server": "3.19.23",
    "typescript": "5.9.3"
  }
}
